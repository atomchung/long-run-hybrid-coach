{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/garmin-coach-loop/plan-state.schema.json",
  "title": "Long Run Hybrid Coach PlanState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "status",
    "goal",
    "cycle",
    "week"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "completed",
        "stopped"
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "measurement_protocol"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "measurement_protocol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "primary_adaptation",
        "maintenance_adaptation",
        "planned_evidence",
        "adjust_conditions",
        "stop_conditions",
        "outlook"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "primary_adaptation": {
          "$ref": "#/$defs/adaptation"
        },
        "maintenance_adaptation": {
          "oneOf": [
            {
              "$ref": "#/$defs/adaptation"
            },
            {
              "type": "null"
            }
          ]
        },
        "planned_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adjust_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outlook": {
          "type": "array",
          "description": "The rest of this cycle, one entry per remaining whole week after plan.week -- so three entries in week 1 and none in week 4. It is what the athlete sees when they ask how the next month goes, and it is deliberately not a plan: an entry carries no session_id and no execution block, so nothing here can be delivered, reconciled, or go stale. A week is precise only once it becomes plan.week at a review.",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "week_start",
              "intent",
              "key_sessions",
              "relation_to_primary"
            ],
            "properties": {
              "week_start": {
                "type": "string",
                "format": "date",
                "description": "The Monday this outlined week begins, exactly seven days after the week before it."
              },
              "intent": {
                "type": "string",
                "minLength": 1,
                "description": "What this week is for, in the same voice plan.week.intent uses."
              },
              "key_sessions": {
                "type": "array",
                "minItems": 1,
                "description": "The sessions that give the week its shape, as the athlete would recognise them -- what kind of session and roughly how much. Precise pace, heart rate, or load belongs to the week that has been made precise; an outlined week states magnitude, not a number no anchor supports yet.",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "relation_to_primary": {
                "type": "string",
                "minLength": 1,
                "description": "How this week moves the cycle's primary adaptation -- build, hold, recover, or measure. Without it a four-week view is four weeks of sessions rather than a direction."
              }
            }
          }
        }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "intent",
        "sessions"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      }
    },
    "athlete_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_pace_sec_per_km",
        "max_hr",
        "easy_hr_ceiling",
        "longest_recent_run_km",
        "weekly_volume_km_4wk_avg",
        "max_session_minutes",
        "strength_loads"
      ],
      "properties": {
        "threshold_pace_sec_per_km": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_hr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "easy_hr_ceiling": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "longest_recent_run_km": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "weekly_volume_km_4wk_avg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_session_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Longest single RUNNING session the athlete will do, in minutes. This is a scheduling constraint on running only -- strength sessions routinely run longer at a fraction of the systemic cost and are not checked against it."
        },
        "strength_loads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/strength_load"
          }
        }
      }
    }
  },
  "$defs": {
    "adaptation": {
      "enum": [
        "aerobic_base",
        "threshold",
        "vo2",
        "strength",
        "hypertrophy",
        "power",
        "recovery"
      ]
    },
    "strength_load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise",
        "load_kg",
        "assist_kg",
        "scheme"
      ],
      "properties": {
        "exercise": {
          "type": "string",
          "minLength": 1
        },
        "load_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "assist_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "scheme": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional name as the athlete writes it in prescriptions, used to match a prescription written in their own language back to this measured baseline."
        }
      }
    },
    "strength_movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise",
        "display_name",
        "sets",
        "reps",
        "load_kg",
        "assist_kg",
        "load_basis"
      ],
      "properties": {
        "exercise": {
          "type": "string",
          "minLength": 1,
          "description": "The canonical key athlete_baseline.strength_loads[].exercise uses, or that entry's display_name, so a planned movement and its measured anchor compare field to field. Never shown to the athlete -- that is display_name."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "description": "The movement as the athlete reads it, in their own language. Required, not optional: this is the only name that reaches them -- through the rendered prescription and, for a strength session, the calendar entry on the watch -- so the only fallback an absent one could have is the canonical key, which is the internal identifier this field exists to keep off the watch face."
        },
        "sets": {
          "type": "integer",
          "minimum": 1
        },
        "reps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Null for a set taken to failure, which has no rep count by design."
        },
        "load_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "assist_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load_basis": {
          "enum": [
            "measured_baseline",
            "bodyweight",
            "pending_confirmation"
          ],
          "description": "Why the load is what it is. measured_baseline carries a kg figure this session's athlete_baseline anchors; bodyweight and pending_confirmation carry none, and say which of the two an absent load means."
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "sport",
        "scheduled_date",
        "time_window",
        "purpose",
        "adaptation",
        "body_stress",
        "cost",
        "priority",
        "planned_minutes",
        "hard",
        "plan",
        "prescription",
        "fallback",
        "execution",
        "match_status"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "sport": {
          "$ref": "#/$defs/sport"
        },
        "scheduled_date": {
          "type": "string",
          "format": "date"
        },
        "time_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "What the session is for, in the Coach's own words, and the title a strength session reaches the athlete's calendar under. It states intent, never a prescription: a number wearing a unit -- a pace, a distance, a load, a heart rate, a percentage -- is refused here because nothing anchors it, and the same number belongs in `plan`, where the evidence gate reads it. A digit alone is intent and stays legal."
        },
        "adaptation": {
          "$ref": "#/$defs/adaptation"
        },
        "body_stress": {
          "enum": [
            "lower",
            "upper",
            "full",
            "systemic"
          ]
        },
        "cost": {
          "enum": [
            "easy",
            "moderate",
            "hard"
          ]
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "planned_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hard": {
          "type": "boolean"
        },
        "plan": {
          "$ref": "#/$defs/session_plan",
          "description": "What this session prescribes, structured. Required on every session: the model a session is executed under is a fact about the session, and one that declares nothing still has to say so."
        },
        "prescription": {
          "type": "string",
          "minLength": 1,
          "description": "The athlete-readable rendering of `plan`, generated by garmin_coach_loop.prescription. Never authored: two sessions with the same plan carry the same text, and a stored value that is not this rendering is refused."
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "description"
          ],
          "properties": {
            "action": {
              "enum": [
                "reduce",
                "move",
                "replace",
                "rest"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publish_supported",
            "external_id",
            "delivery_state"
          ],
          "properties": {
            "publish_supported": {
              "type": "boolean"
            },
            "external_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "delivery_state": {
              "enum": [
                "not_published",
                "intervals_accepted"
              ],
              "description": "Observed delivery only. not_published means no verified Intervals event is recorded; intervals_accepted means a deterministic write was read back and its absolute workout targets matched. Garmin forwarding and device sync are outside this product's observable state."
            },
            "superseded_external_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "The Intervals event id this session was delivered under before a confirmed change invalidated that content. The event still exists on the athlete's calendar: it is cleared when the replacement delivery overwrites it, or when it is withdrawn."
            }
          }
        },
        "match_status": {
          "enum": [
            "planned",
            "completed",
            "partial",
            "moved",
            "replaced",
            "missed"
          ]
        }
      }
    },
    "priority": {
      "enum": [
        "anchor",
        "flexible",
        "optional"
      ]
    },
    "sport": {
      "enum": [
        "running",
        "strength",
        "mobility",
        "recovery",
        "rest"
      ]
    },
    "session_plan": {
      "description": "One session's prescribed work, classified by how it is executed rather than by which sport it is. Swimming and running are the same thing -- a sequence with an intensity target a device follows; yoga and a recovery day are the same thing -- an intent with nothing to verify. `kind` decides which validation runs; `sport` does not. Only the three models this product has today are defined; a sport it meets later reuses whichever of them fits, as one `sport` value and no new structure.",
      "oneOf": [
        {
          "$ref": "#/$defs/plan_time_axis"
        },
        {
          "$ref": "#/$defs/plan_movement_list"
        },
        {
          "$ref": "#/$defs/plan_unstructured"
        }
      ]
    },
    "plan_time_axis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Work laid out along time or distance, with one intensity target per session. This is the canonical executable content: delivery derives its preview and provider payload from it, and no separate workout request may override it.",
      "required": [
        "kind",
        "name",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "time_axis"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workout_step"
          }
        }
      }
    },
    "plan_movement_list": {
      "type": "object",
      "additionalProperties": false,
      "description": "Work laid out as movements, each with its own sets, reps and load basis. It is never part of a provider payload -- a movement list still publishes as a titled calendar entry with no executable structure.",
      "required": [
        "kind",
        "movements"
      ],
      "properties": {
        "kind": {
          "const": "movement_list"
        },
        "movements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/strength_movement"
          }
        }
      }
    },
    "plan_unstructured": {
      "type": "object",
      "additionalProperties": false,
      "description": "A session that declares no numbers at all -- mobility, recovery, rest. It carries no field beyond its own kind on purpose: there is nothing here for an evidence check to read, and equally nothing a pace or a load could be hidden in. A run may never use it: a run has to say what the watch executes, and a run left to feel is a plan_time_axis carrying an open target. A strength session normally carries a movement list, but may declare this instead when the athlete declines to enumerate movements -- that adopts with a warning, and nothing on the session is then checked against the baseline.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "unstructured"
        }
      }
    },
    "workout_step": {
      "oneOf": [
        {
          "$ref": "#/$defs/workout_work_step"
        },
        {
          "$ref": "#/$defs/workout_repeat_step"
        }
      ]
    },
    "workout_work_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "duration",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "work"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "$ref": "#/$defs/workout_duration"
        },
        "target": {
          "$ref": "#/$defs/workout_target"
        }
      }
    },
    "workout_repeat_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repetitions",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "repeat"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "A work step inside a repeat: a workout_work_step whose target may not be an hr_ceiling.",
            "allOf": [
              {
                "$ref": "#/$defs/workout_work_step"
              },
              {
                "properties": {
                  "target": {
                    "$ref": "#/$defs/workout_repeat_child_target"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "workout_duration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seconds"
          ],
          "properties": {
            "kind": {
              "const": "time"
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "meters"
          ],
          "properties": {
            "kind": {
              "const": "distance"
            },
            "meters": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "workout_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "open"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "unit",
            "low_seconds_per_km",
            "high_seconds_per_km"
          ],
          "properties": {
            "kind": {
              "const": "pace"
            },
            "unit": {
              "const": "sec_per_km"
            },
            "low_seconds_per_km": {
              "type": "integer",
              "minimum": 1
            },
            "high_seconds_per_km": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "An absolute heart-rate ceiling in bpm. There is deliberately no floor field: the plan binds an upper bound only, so a lower bound must be unrepresentable rather than merely undocumented. This bpm figure is canonical; delivery renders it as a percentage of the provider account's Run threshold HR, resolving at or below this ceiling and never above it, because absolute bpm does not survive the export to the watch. Two rules this schema cannot express are enforced by validate_plan_state: an hr_ceiling target may not appear inside a repeat, and one workout may not mix pace and hr_ceiling targets.",
          "required": [
            "kind",
            "unit",
            "ceiling_bpm"
          ],
          "properties": {
            "kind": {
              "const": "hr_ceiling"
            },
            "unit": {
              "const": "bpm"
            },
            "ceiling_bpm": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "workout_repeat_child_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "open"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "unit",
            "low_seconds_per_km",
            "high_seconds_per_km"
          ],
          "properties": {
            "kind": {
              "const": "pace"
            },
            "unit": {
              "const": "sec_per_km"
            },
            "low_seconds_per_km": {
              "type": "integer",
              "minimum": 1
            },
            "high_seconds_per_km": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
